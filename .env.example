# Copier ce fichier en ".env" (non versionné) et renseigner les valeurs réelles.

# ID du projet Google Cloud associé à Earth Engine (même valeur que EE_PROJECT_ID dans app.py)
EE_PROJECT_ID=ton-projet-google-cloud

# Dossier contenant les credentials Earth Engine déjà générés par `earthengine authenticate`
# Windows (chemin Docker Desktop) :
EE_CONFIG_DIR=C:/Users/HP/.config/earthengine

# Fréquence et fenêtre de l'export NDVI automatique
GEE_INTERVAL_HOURS=24
GEE_LOOKBACK_DAYS=14

# Clé API OpenRouteService (https://openrouteservice.org/dev/#/signup) — utilisée dans le
# processeur InvokeHTTP du flux NiFi "ORS", pas par un script Python
ORS_API_KEY=ta-cle-openrouteservice
