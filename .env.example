# Copy to .env (gitignored) and adjust if needed. Defaults below match what's
# hardcoded in infra/seaweedfs/s3.json and docker-compose.yml — this file only
# needs editing if you want different dev credentials.

# --- M1: object storage identity (must match infra/seaweedfs/s3.json) ------
SEAWEEDFS_ACCESS_KEY=platform
SEAWEEDFS_SECRET_KEY=platform-dev-secret-please-rotate

# --- M1: Postgres (catalog stores: pgstac, dagster, cube, platform, lakekeeper) --
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform-dev-secret-please-rotate

# --- M2: Lakekeeper (Iceberg REST catalog) ----------------------------------
LAKEKEEPER_ENCRYPTION_KEY=lakekeeper-dev-encryption-key-please-rotate

# --- Real data connectors (optional — platform works with fixtures if unset) --

# Google Earth Engine: path to the service-account JSON key ON YOUR HOST.
# Docker mounts it read-only into the dagster container at /secrets/gee-sa-key.json.
GEE_KEY_FILE=
